-obj-y += drivers/media/i2c/
-
-ifeq ($(call version_lt,$(KERNEL_VERSION),$(KV_I2C_KV_I2C_MAX9X_ISX031)),false)
-obj-y += drivers/media/platform/intel/
-endif
-
-# Override LINUXINCLUDE to put our include path first
+# Industrial / automotive sensor drivers (AR0234, LT6911UX{C,E}, ISX031,
+# MAX9X) and the IPU-ACPI platform glue are disabled for DKMS builds on
+# consumer laptops: they don't apply to common ADL/MTL/RPL laptops, the
+# non-upstream sensor .c files require manual renaming, and ISX031 has a
+# struct-vs-printf mismatch (sensor_platform_data->suffix is `char`, the
+# driver formats it with %s). Re-enable here if you have hardware that
+# needs them and apply the corresponding patches from patch/v6.18.3/.
+#
+# export CONFIG_VIDEO_LT6911UXE = m
+# export CONFIG_VIDEO_LT6911UXC = m
+# export CONFIG_VIDEO_AR0234 = m
+# export CONFIG_VIDEO_ISX031=m
+# export CONFIG_VIDEO_MAX9X=m
+# obj-y += drivers/media/i2c/
+# ifeq ($(call version_lt,$(KERNEL_VERSION),$(KV_I2C_KV_I2C_MAX9X_ISX031)),false)
+# obj-y += drivers/media/platform/intel/
+# endif
+
+# Override LINUXINCLUDE to put our include path first.
 LINUXINCLUDE := -I$(src)/include $(LINUXINCLUDE)
 
+# -include the namespace compat shim from subdir-ccflags-y (not
+# LINUXINCLUDE), so it lands AFTER the kernel's auto-included
+# <linux/kconfig.h>. The shim redefines MODULE_IMPORT_NS /
+# EXPORT_SYMBOL_NS_GPL on kernel >= 6.13 (commit cdd30ebb1b9f) so
+# call sites can keep their historic unquoted-namespace form.
 subdir-ccflags-y += -I$(src)/include/ \
+	-include $(src)/include/ipu-namespace-compat.h \
 	-DCONFIG_VIDEO_V4L2_SUBDEV_API
 
 subdir-ccflags-$(CONFIG_INTEL_IPU_ACPI) += \
