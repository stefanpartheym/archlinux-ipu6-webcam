# Maintainer: forked in archlinux-ipu6-webcam (kernel-7-dkms-fixes)
# Upstream AUR maintainer: Stick <stick@stma.is>
#
# libcamera-ipu6-fix -- local fork of the AUR libcamera-ipu6 package
# that adds one extra patch on top:
#   0003-ipu6-workerThread-drop-stale-buffers-instead-of-asserting.patch
#     Guards the IPU6 pipeline handler's workerThread completeBuffer()
#     call against a request whose pending_ set has already been
#     cleared. Fixes a recurring wireplumber SIGABRT observed 4x over
#     5 weeks (see IPU6-investigation-2026-05-22.md gotcha #4).
#
# All other patches, scripts, packaging split, provides/conflicts etc.
# are unchanged from the AUR package -- this is a strict superset. The
# split packages use -fix suffixes and declare provides=(<AUR name>) +
# conflicts=(<AUR name>) so they act as drop-in replacements for
# libcamera-ipu6 / -ipa / -tools / gst-plugin-libcamera-ipu6 /
# python-libcamera-ipu6 -- same pattern as this repo's other -fix
# variants (intel-ipu6ep-camera-{hal-git,bin}-fix).

pkgbase=libcamera-ipu6-fix
pkgname=(
  libcamera-ipu6-fix
  libcamera-ipu6-ipa-fix
  libcamera-ipu6-tools-fix
  gst-plugin-libcamera-ipu6-fix
  python-libcamera-ipu6-fix
)
_libcamera_ver=0.7.0
_ov01a10_iter=2
pkgver=${_libcamera_ver}+ov01a10.${_ov01a10_iter}
pkgrel=3
pkgdesc="libcamera with Intel IPU6 pipeline handler (kervel fork), OV01A10 support, and workerThread race fix"
arch=(x86_64)
url="https://github.com/kervel/libcamera"
license=(
