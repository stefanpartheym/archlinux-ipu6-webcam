_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

prepare() {
  cd libcamera
  patch -Np1 < ../0001-ipa-Add-OV01A10-sensor-helper.patch
  patch -Np1 < ../0002-ipu6-make-libcamhal-init-process-global.patch
  # 0003 is applied via the Python transform below, not `patch -Np1`.
  # See ../0003-...patch header for why (large multi-line block replacement).

  # 0003 (pkgrel=3, 2026-08-26): guard IPU6CameraData::workerThread against
  # a stale/cancelled request BEFORE the ~50 ms memcpy. Two important
  # subtleties for pkgrel=3, promoted from pkgrel=2:
  #
  #   (A) Only the ONLY-caller-that-pops-queuedRequests_ is
  #       PipelineHandler::completeRequest, and it stops at the first
  #       RequestPending at the head. If our guard skips a request
  #       silently, that request stays in queuedRequests_ with
  #       status=RequestPending FOREVER, blocking every later completion
  #       behind it. That's the "PipeWire graph goes stale after some
  #       uptime" symptom -- systemctl --user restart pipewire ... fixes
  #       it because the fresh graph doesn't inherit the stuck queue.
  #       pkgrel=3 fixes this by calling pipe()->completeRequest(request)
  #       in the skip path when status == RequestPending. That's safe:
  #       Request::Private::complete() asserts status==RequestPending
  #       (yes) and !hasPendingBuffers() (yes -- that's why we skipped),
  #       both hold. If Request::Private::cancel() had cleared pending_
  #       upstream, the resulting terminal state is RequestCancelled
  #       (cancelled_ flag was set); otherwise RequestComplete. Both are
  #       terminal states the drain-loop pops.
  #
  #   (B) When status != RequestPending, the request has already been
  #       through complete() at least once. Calling completeRequest a
  #       second time would trip complete()'s ASSERT(status ==
  #       RequestPending) at request.cpp:132. So we keep the pure-skip
  #       path only for that subcase.
  python3 - <<'PY'
p = 'src/libcamera/pipeline/ipu6/ipu6.cpp'
s = open(p).read()

# The exact block that ships in kervel/libcamera@48748f15. String-replace
# so we don't have to fight `patch` with drifting line numbers -- the
# block just needs to appear verbatim in the source.
old = '''		if (request) {
			/* Copy HAL buffer data into the libcamera FrameBuffer */
			FrameBuffer *buffer = request->findBuffer(&stream_);
			if (buffer) {
				MappedFrameBuffer mapped(buffer,
							 MappedFrameBuffer::MapFlag::Write);
				if (mapped.isValid()) {'''

new = '''		if (request) {
			FrameBuffer *buffer = request->findBuffer(&stream_);

			/*
			 * Guard against a stale/cancelled request BEFORE we
			 * spend ~50 ms on the memcpy below. Without this guard,
			 * Request::Private::completeBuffer() aborts on
			 *   ASSERT(pending_.erase(buffer) == 1);
			 * (request.cpp:111), taking wireplumber with it. See
			 * archlinux-ipu6-webcam IPU6-investigation-2026-05-22.md
			 * gotcha #4 for the recurring backtrace this fixes.
			 *
			 * If we skip, we STILL must call completeRequest() when
			 * the request is still RequestPending, otherwise it sits
			 * in Camera::Private::queuedRequests_ forever, blocking
			 * all subsequent completions behind it (which manifests
			 * as PipeWire "target not found" and a graph-goes-stale
			 * symptom after some uptime). complete() asserts
			 * status==RequestPending && !hasPendingBuffers(); both
			 * are exactly the guard's preconditions in that arm.
			 */
			bool __ipu6_stale = !buffer ||
				request->status() != Request::RequestPending ||
				!request->_d()->hasPendingBuffers();
			if (__ipu6_stale) {
				LOG(IPU6, Debug)
					<< "Skipping stale request in worker "
					   "(cancelled or completed elsewhere)";
				if (request->status() == Request::RequestPending &&
				    !request->_d()->hasPendingBuffers()) {
					/*
					 * Drain from queuedRequests_. safe: complete()'s
					 * asserts (status==Pending, !hasPendingBuffers)
					 * both hold here by construction.
					 */
					pipe()->completeRequest(request);
				}
			} else if (buffer) {
				MappedFrameBuffer mapped(buffer,
							 MappedFrameBuffer::MapFlag::Write);
				if (mapped.isValid()) {'''

if old not in s:
    raise SystemExit("PKGBUILD 0003 python transform: 'old' block not found in ipu6.cpp -- source drift?")
s = s.replace(old, new, 1)
open(p, 'w').write(s)
PY

  # The fork ships ov01a10.yaml in src/ipa/simple/data/ but its meson.build
  # only installs uncalibrated.yaml. Add ov01a10.yaml to the install list.
  sed -i "s|'uncalibrated.yaml',|'uncalibrated.yaml',\n    'ov01a10.yaml',|" \
    src/ipa/simple/data/meson.build

  # The fork has the ov01a10 sensorProps entry but is missing the
  # .sensorDelays member that became required after the entry was merged.
  # -Werror=missing-field-initializers turns this into a build failure.
  # Insert exposureDelay=2, gainDelay=2 (per Intel HAL tuning) before
  # the closing brace of the ov01a10 entry.
  python3 - <<'PY'
p = 'src/libcamera/sensor/camera_sensor_properties.cpp'
s = open(p).read()
needle = '\t\t{ "ov01a10", {'
i = s.index(needle)
end = s.index('\t\t} },', i)
patch = (
    '\t\t\t.sensorDelays = {\n'
    '\t\t\t\t.exposureDelay = 2,\n'
    '\t\t\t\t.gainDelay = 2,\n'
    '\t\t\t\t.vblankDelay = 0,\n'
    '\t\t\t\t.hblankDelay = 0\n'
    '\t\t\t},\n'
)
open(p, 'w').write(s[:end] + patch + s[end:])
PY

  printf "%s\n" "$pkgver" > .tarball-version
}

build() {
  local meson_options=(
    -D documentation=disabled
    -D pipelines=ipu6,simple,uvcvideo
    -D test=true
    -D tracing=disabled
    -D v4l2=enabled
  )
  arch-meson libcamera build "${meson_options[@]}"
  meson compile -C build

  cc -O2 -Wall -o wait-libcamhal-shm ../wait-libcamhal-shm.c
}

check() {
  local tests
  tests=$(meson test -C build --list | awk '{print $3}' \
    | grep -v single_stream_test \
    | grep -v multi_stream_test \
    | grep -v memory_lifetime_test)
  # shellcheck disable=SC2086
  meson test -C build $tests
}

package_libcamera-ipu6-fix() {
  pkgdesc+=" - main library"
  depends=(
    glibc
    gnutls
    intel-ipu6-camera-hal-git
    libcamera-ipu6-ipa-fix
    libelf
    libgcc
    libglvnd
    libstdc++
    libunwind
    libyaml
    libyuv
    sh
    systemd-libs libudev.so
  )
  optdepends=(
    'gst-plugin-libcamera-ipu6-fix: GStreamer plugin'
    'libcamera-ipu6-tools-fix: applications (cam, qcam, lc-compliance)'
    'intel-ipu6-camera-bin: closed-blob firmware (.aiqb tuning files) - required at runtime'
    'intel-ipu6-dkms-git: out-of-tree intel_ipu6_psys kernel module - required at runtime'
  )
  provides=(libcamera libcamera.so libcamera-base.so libcamera-ipu6)
  conflicts=(libcamera libcamera-ipu6)
  replaces=(libcamera libcamera-ipu6)

  meson install -C build --destdir "$pkgdir"
  install -vDm 644 libcamera/LICENSES/{BSD-3-Clause,Linux-syscall-note,MIT}.txt \
    -t "$pkgdir/usr/share/licenses/$pkgname/"

  install -vDm 644 ../99-ipu6-psys.rules     "$pkgdir/usr/lib/udev/rules.d/99-ipu6-psys.rules"
  install -vDm 644 ../60-libcamera-ipu6.conf "$pkgdir/usr/lib/environment.d/60-libcamera-ipu6.conf"
  install -vDm 644 ../10-libcamera-ipu6-ipc.conf \
    "$pkgdir/usr/lib/systemd/user/pipewire.service.d/10-libcamera-ipu6-ipc.conf"
  install -vDm 644 ../10-libcamera-ipu6-ipc.conf \
    "$pkgdir/usr/lib/systemd/user/wireplumber.service.d/10-libcamera-ipu6-ipc.conf"
  install -vDm 755 wait-libcamhal-shm \
    "$pkgdir/usr/lib/libcamera-ipu6/wait-libcamhal-shm"

  (
    cd "$pkgdir"
    _pick libcamera-ipu6-ipa-fix       usr/lib/libcamera/
    # NOTE: pick libcamera-bug-report along with cam/qcam/lc-compliance
    # so it lands in the -tools split. Upstream AUR PKGBUILD misses it,
    # causing a /usr/bin/libcamera-bug-report file conflict between
    # libcamera-ipu6 and libcamera-tools when the two packages are
    # installed side-by-side. Putting it in -tools where the other
    # binaries live is what upstream libcamera does anyway.
    _pick libcamera-ipu6-tools-fix     usr/bin/{cam,qcam,lc-compliance,libcamera-bug-report}
    _pick gst-plugin-libcamera-ipu6-fix usr/lib/gstreamer-*
    _pick python-libcamera-ipu6-fix    usr/lib/python*
  )
}

package_libcamera-ipu6-ipa-fix() {
  pkgdesc+=" - signed IPA"
  license=(
    BSD-2-Clause
    CC-BY-SA-4.0
    CC0-1.0
    GPL-2.0-or-later
    LGPL-2.1-or-later
  )
  depends=(
    glibc
    libcamera-ipu6-fix libcamera.so libcamera-base.so
    libgcc
    libstdc++
  )
  provides=(libcamera-ipa libcamera-ipu6-ipa)
  conflicts=(libcamera-ipa libcamera-ipu6-ipa)
  replaces=(libcamera-ipa libcamera-ipu6-ipa)
  options=(!strip)

  strip libcamera-ipu6-ipa-fix/usr/lib/libcamera/*{.so,proxy}
  for _lib in libcamera-ipu6-ipa-fix/usr/lib/libcamera/*.so; do
    libcamera/src/ipa/ipa-sign.sh \
      "$(find build -type f -iname '*ipa-priv-key.pem')" \
      "$_lib" "$_lib.sign"
  done
  mv -v libcamera-ipu6-ipa-fix/* "$pkgdir"
  install -vDm 644 libcamera/LICENSES/BSD-2-Clause.txt \
    -t "$pkgdir/usr/share/licenses/$pkgname/"
}

